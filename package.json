{
  "name": "flowfit",
  "version": "1.0.0",
  "private": true,
  "description": "Flowfit, a fast workout logging app with an optional AI coach (Android, Capacitor)",
  "scripts": {
    "android:add": "npx cap add android",
    "android:assets": "npx capacitor-assets generate --android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "apk": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0"
  },
  "license": "MIT",
  "author": "Yashas Tej CM",
  "repository": {
    "type": "git",
    "url": "https://github.com/yashastejcm4/flowfit.git"
  }
}
