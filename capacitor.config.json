{
  "appId": "com.yash.flowfit",
  "appName": "Flowfit",
  "webDir": "www",
  "android": {
    "backgroundColor": "#0e0e0e",
    "allowMixedContent": false
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 300,
      "launchAutoHide": true,
      "backgroundColor": "#0e0e0e",
      "showSpinner": false
    },
    "LocalNotifications": {
      "iconColor": "#BEF264"
    }
  }
}
